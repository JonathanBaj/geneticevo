from numpy import bool_, float32, int64
from numpy.typing import NDArray

from .rust_ppo import RustNativePPO

_Topology = tuple[tuple[int, ...], tuple[int, list[tuple[int, int]], int] | None]
_Rng = tuple[int, int, int, int]
_FloatArray = NDArray[float32]
_Actions = NDArray[int64] | _FloatArray
_Adam = tuple[int, _FloatArray, _FloatArray]

class Population:
    def __init__(self, observation_dim: int, discrete: bool, low: list[float], high: list[float],
                 settings: RustNativePPO) -> None: ...
    def add(self, spec: _Topology, genes: _FloatArray, rng: _Rng, adam: _Adam | None = None) -> None: ...
    def get_genes(self, index: int) -> _FloatArray: ...
    def replace_topology(self, index: int, spec: _Topology, genes: _FloatArray) -> None: ...
    def export(self) -> list[tuple[_FloatArray, int, _FloatArray, _FloatArray, _Rng]]: ...
    def act(self, obs: _FloatArray) -> _Actions: ...
    def forward(self, obs: _FloatArray, critic: bool = False) -> _FloatArray: ...
    def sample(self, obs: _FloatArray) -> _Actions: ...
    def record(self, rewards: _FloatArray, terminated: NDArray[bool_], truncated: NDArray[bool_],
               next: _FloatArray) -> None: ...
    def update(self) -> _FloatArray: ...
