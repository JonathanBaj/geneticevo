from numpy import float32, int64
from numpy.typing import NDArray

_Topology = tuple[tuple[int, ...], tuple[int, list[tuple[int, int]], int] | None]
_FloatArray = NDArray[float32]

class Population:
    def __init__(self, observation_dim: int, discrete: bool, low: list[float], high: list[float]) -> None: ...
    def add(self, spec: _Topology, genes: _FloatArray) -> None: ...
    def act(self, obs: _FloatArray) -> NDArray[int64] | _FloatArray: ...
    def forward(self, obs: _FloatArray, critic: bool = False) -> _FloatArray: ...
